# Copy to .env.local and fill in. For local development, `npx supabase start` prints these values.

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Public URL of the site (used in email links and QR labels)
APP_URL=http://localhost:3000

# ---------------------------------------------------------------- email
# Option A (easiest): send from the studio's Gmail account.
#   Google Account → Security → 2-Step Verification → App passwords → create one for "Mail".
#   Then set: SMTP_HOST=smtp.gmail.com  SMTP_PORT=465  SMTP_USER=<the gmail address>  SMTP_PASS=<app password>
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="BME Design Studio <your-studio@gmail.com>"
# Option B: https://resend.com (needs your own domain). Used only when SMTP_HOST is empty.
RESEND_API_KEY=
# With neither set, emails are printed to the server log instead.

# ------------------------------------------------------------------ SMS
# One of: afromessage | africastalking | twilio   (empty = print SMS to the server log)
SMS_PROVIDER=
# AfroMessage (Ethiopia) — https://afromessage.com → Developer → token & identifier
AFROMESSAGE_TOKEN=
AFROMESSAGE_IDENTIFIER_ID=
AFROMESSAGE_SENDER_NAME=
# Africa's Talking — use username "sandbox" to test for free
AT_USERNAME=
AT_API_KEY=
AT_SENDER_ID=
# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# Protects /api/cron/alerts. Vercel Cron sends it automatically when set in the project.
CRON_SECRET=change-me-to-a-long-random-string

# Time zone used for due dates and the monthly check-in
APP_TIMEZONE=Africa/Addis_Ababa
